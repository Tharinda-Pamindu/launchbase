# Loaded by `vite build` (`make build`). Committed — public, non-secret values only.
# Add `VITE_`-prefixed vars here as the site needs them; Vite inlines them
# into the bundle.
# Where "Get started" and "Sign in" send people (the customer app). Set to
# the deployed app's URL; the local default keeps a local build working.
VITE_APP_URL=http://localhost:3001
# This site's own public URL, for Open Graph image links.
VITE_SITE_URL=http://localhost:3000
